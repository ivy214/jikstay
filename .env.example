# .env 견본 — 이 파일을 .env 로 복사한 뒤 빈 값을 채운다 (.env 는 커밋 금지).
# GitHub Actions 는 같은 이름의 Secrets 를 쓴다 (weekly-travel-hub-update.yml).

# Firebase Admin SDK (프로젝트 jikstay-lkxu1) — firebase_client.py
# 서비스 계정 키: 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 → backend/ 에 저장
FIREBASE_CREDENTIALS=serviceAccountKey.json
FIREBASE_BUCKET=jikstay-lkxu1.firebasestorage.app

# 공공데이터포털 공용 키 — 인허가 조회, 문화정보원 공연·전시, TourAPI 키가 없을 때 대신 사용
DATA_GO_KR_SERVICE_KEY=
# 한국관광공사 TourAPI — 관광지·축제·캠핑장·두루누비 걷기길
TOUR_API_KEY=
# KOPIS 공연 정보 — refresh_culture.py 지방 공연 보강
KOPIS_API_KEY=

# 행안부 인허가 API 주소(비밀 아님) — license_check.py. 농어촌민박업·관광숙박업은 코드 기본값
LICENSE_API_LODGING=https://apis.data.go.kr/1741000/lodgings
LICENSE_API_HANOK=https://apis.data.go.kr/1741000/hanok_experience
LICENSE_API_FOREIGN=https://apis.data.go.kr/1741000/foreigner_city_homestays

# 네이버 지역 검색 — 장소 정보 보강, 리뷰·링크
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 번역 — Azure Translator 무료(F0) 우선, 한도·오류 시 Gemini (translate_hub.py)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Gemini — 허브 콘텐츠 생성·보강, 번역 예비
GEMINI_API_KEY=
# OpenAI — 번역 예비 (GEMINI_API_KEY 가 없을 때만)
OPENAI_API_KEY=
